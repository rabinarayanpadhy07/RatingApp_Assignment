{
  "name": "rating-app",
  "version": "1.0.0",
  "description": "Store Rating and Review Fullstack Application",
  "scripts": {
    "start": "cd backend && npm start",
    "build": "cd frontend && npm run build",
    "init-db": "cd backend && npm run init-db",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test:api": "cd backend && node src/scripts/comprehensiveValidationTest.js"
  }
}
