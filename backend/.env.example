# ==========================================
# Store Rating App - Backend Environment Example
# ==========================================

# Application Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=rating_app

# Set to 'true' if connecting to a cloud database requiring SSL/TLS (e.g. AWS RDS, Aiven)
DB_SSL=false

# JSON Web Token Secret & Expiration
# Generate a strong 256-bit secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (Comma-separated for multiple origins, or single domain)
# Example: https://ratingapp.yourdomain.com
CORS_ORIGIN=*
