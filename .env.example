# ===================================================
# Store Rating App - Root Environment Variables Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=rating_app
DB_SSL=false

# Authentication (JWT)
# Generate a strong 256-bit secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS (Allowed origins for API requests)
# Set to '*' for all origins or specify domains: https://yourdomain.com
CORS_ORIGIN=*
